<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tiled"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainMenuActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="320dp"
                android:layout_height="122dp"
                android:background="@drawable/tetris" />

            <LinearLayout
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="60dp"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:id="@+id/btnPlay"
                    android:layout_width="200dp"
                    android:layout_height="100dp"
                    android:background="@drawable/play" />

                <FrameLayout
                    android:id="@+id/btnTutorial"
                    android:layout_width="200dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/tutorial" />

            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:id="@+id/btnSound"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/sound"
            android:scaleType="fitCenter" />

        <FrameLayout
            android:id="@+id/soundMenuLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/sound_menu"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:paddingTop="40dp">

                <SeekBar
                    android:id="@+id/seekBarBgm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="#FFFFFF"
                    android:thumbTint="#FFFFFF" />


                <ImageView
                    android:id="@+id/btnCloseSoundMenu"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/quit"
                    android:scaleType="fitCenter" />

            </LinearLayout>

        </FrameLayout>

        <!-- Lớp phủ Menu Hướng dẫn chơi -->
        <FrameLayout
            android:id="@+id/tutorialLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true">

            <!-- Hình nền how_to_play -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/how_to_play"
                android:scaleType="fitCenter" />

            <!-- Nội dung chữ (Căn chỉnh để lọt vào khung ảnh) -->
            <LinearLayout
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:paddingTop="50dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:text="SWIPE LEFT/RIGHT\nTO MOVE BLOCK"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:lineSpacingExtra="6dp"
                    android:textAlignment="center"
                    android:fontFamily="@font/press_start_2p" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:text="TAP TO ROTATE"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textAlignment="center"
                    android:fontFamily="@font/press_start_2p" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:text="SWIPE DOWN\nTO DROP FASTER"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:lineSpacingExtra="6dp"
                    android:textAlignment="center"
                    android:fontFamily="@font/press_start_2p" />

                <ImageView
                    android:id="@+id/btnCloseTutorial"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:src="@drawable/quit"
                    android:scaleType="fitCenter" />

            </LinearLayout>

        </FrameLayout>

    </FrameLayout>

</LinearLayout>